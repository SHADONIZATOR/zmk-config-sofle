#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&led_strip { chain-length = <29>; };

/ {
    combos {
        compatible = "zmk,combos";

        Left_br {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <21 22>;
        };

        Right_br {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <22 23>;
        };

        Sqt {
            bindings = <&kp SQT>;
            key-positions = <33 34>;
        };

        Grave {
            bindings = <&kp GRAVE>;
            key-positions = <17 16>;
        };

        Slash {
            bindings = <&kp KP_SLASH>;
            key-positions = <49 48>;
        };

        Backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <48 47>;
        };
    };

    behaviors {
        Numpad_lock: Numpad_lock {
            compatible = "zmk,behavior-tap-dance";
            label = "NUMPAD_LOCK";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&tog 2>;
        };

        Left_fs: Left_fs {
            compatible = "zmk,behavior-tap-dance";
            label = "LEFT_FS";
            #binding-cells = <0>;
            bindings = <&kp DELETE>, <&tog 3>;
        };

        Encoder_mouse_horizontal: Encoder_mouse_horizontal {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MOUSE_HORIZONTAL";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_X(100)>, <&mmv MOVE_X(-100)>;

            tap-ms = <20>;
        };

        Encoder_mouse_vertical: Encoder_mouse_vertical {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MOUSE_VERTICAL";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_Y(-100)>, <&mmv MOVE_Y(100)>;

            tap-ms = <20>;
        };

        test: test {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "TEST";
            #sensor-binding-cells = <2>;
            bindings = <&mmv>, <&mmv>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Main {
            label = "Main";
            bindings = <
&kp ESCAPE      &kp N1  &kp N2    &kp N3        &kp N4        &kp N5                          &kp N6        &kp N7         &kp N8         &kp N9   &kp N0    &kp BACKSPACE
&kp TAB         &kp Q   &kp W     &kp E         &kp R         &kp T                           &kp Y         &kp U          &kp I          &kp O    &kp P     &kp MINUS
&kp LEFT_SHIFT  &kp A   &kp S     &kp D         &kp F         &kp G                           &kp H         &kp J          &kp K          &kp L    &kp SEMI  &kp RIGHT_SHIFT
&kp LCTRL       &kp Z   &kp X     &kp C         &kp V         &kp B   &mkp MB1     &mkp MB2   &kp N         &kp M          &kp COMMA      &kp DOT  &kp FSLH  &kp EQUAL
                        &Left_fs  &kp LEFT_WIN  &kp LEFT_ALT  &mo 1   &kp SPACE    &kp SPACE  &Numpad_lock  &kp RIGHT_ALT  &kp RIGHT_GUI  &trans
            >;

            sensor-bindings =
                <&test MOVE_X(300) MOVE_X(-300)>,
                <&Encoder_mouse_vertical>;
        };

        Left_lb {
            label = "Left_lb";
            bindings = <
&kp GRAVE         &kp NUMBER_6       &kp N7             &kp N8           &kp NUMBER_9      &kp NUMBER_0                          &kp F1         &kp F2          &kp F3          &kp F4           &kp F5            &kp F6
&kp CAPS          &kp LS(LA(LC(M)))  &kp LS(LA(LC(D)))  &kp C_PREVIOUS   &kp C_PLAY_PAUSE  &kp C_NEXT                            &kp F7         &kp F8          &kp F9          &kp F10          &kp F11           &kp F12
&kp LEFT_SHIFT    &kp Y              &kp K              &kp I            &kp H             &kp J                                 &kp PAGE_UP    &kp HOME        &kp UP_ARROW    &kp END          &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&kp LEFT_CONTROL  &kp N              &kp O              &kp P            &kp N             &kp M         &trans       &trans     &kp PAGE_DOWN  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans            &trans
                                     &kp BACKSPACE      &kp PRINTSCREEN  &kp LG(LC(V))     &trans        &kp ENTER    &kp ENTER  &trans         &kp RIGHT_ALT   &trans          &trans
            >;

            sensor-bindings =
                <&Encoder_mouse_horizontal>,
                <&Encoder_mouse_vertical>;
        };

        Numpad {
            label = "Numpad";
            bindings = <
&studio_unlock   &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_HUI            &rgb_ug RGB_HUD        &rgb_ug RGB_TOG                                       &kp KP_NUMLOCK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_DIVIDE    &trans
&rgb_ug RGB_SAI  &rgb_ug RGB_SPI  &rgb_ug RGB_EFF  &kp LS(LA(LC(LESS_THAN)))  &kp LS(LA(LC(SLASH)))  &kp LS(LA(LC(GREATER_THAN)))                          &trans          &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MULTIPLY  &trans
&rgb_ug RGB_SAD  &rgb_ug RGB_SPD  &rgb_ug RGB_EFR  &trans                     &trans                 &trans                                                &trans          &kp KP_NUMBER_3  &kp KP_NUMBER_2  &kp KP_NUMBER_1  &kp KP_SUBTRACT  &kp SINGLE_QUOTE
&bt BT_CLR       &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2               &bt BT_SEL 3           &bt BT_SEL 4                  &trans       &trans     &trans          &kp KP_EQUAL     &kp KP_NUMBER_0  &kp KP_DOT       &kp KP_PLUS      &trans
                                  &trans           &trans                     &trans                 &trans                        &kp ENTER    &kp ENTER  &trans          &trans           &trans           &trans
            >;

            sensor-bindings =
                <&Encoder_mouse_horizontal>,
                <&Encoder_mouse_vertical>;
        };

        Left_add {
            label = "Left_add";
            bindings = <
&kp F1             &kp F2             &kp F3             &kp F4             &kp F5   &kp F6                           &trans  &trans  &trans  &trans  &trans  &trans
&kp F7             &kp F8             &kp F9             &kp F10            &kp F11  &kp F12                          &trans  &trans  &trans  &trans  &trans  &trans
&trans             &trans             &trans             &trans             &trans   &trans                           &trans  &trans  &trans  &trans  &trans  &trans
&kp LC(LA(LS(H)))  &kp LC(LA(LS(B)))  &kp LC(LA(LS(S)))  &kp LC(LA(LS(F)))  &trans   &trans   &trans       &trans     &trans  &trans  &trans  &trans  &trans  &trans
                                      &trans             &trans             &trans   &trans   &kp ENTER    &kp ENTER  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&Encoder_mouse_horizontal>,
                <&Encoder_mouse_vertical>;
        };

        reserved1 {
            status = "reserved";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        reserved2 {
            status = "reserved";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        reserved3 {
            status = "reserved";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
